# ============================================================================
#  GL-MT5000 (Brume 3) — MediaTek MT7987A / mediatek-filogic / aarch64
#  MINIMAL DSA + PPE hardware flow-offload build.
#  Base: official OpenWrt main (kernel 6.18), official feeds only.
#  Seed .config — expanded by `make defconfig`. No external feeds, no proxy
#  stack, no themes.
#
#  The Realtek RTL8371C (RTL8366UB) DSA switch driver and its 802.1Q tagger
#  are built directly into the kernel via target/linux/mediatek/filogic/config-6.18
#  (CONFIG_NET_DSA_REALTEK_RTL8366UB=y).
# ============================================================================

# ---- Target / device ----
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt5000=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# Also emit an initramfs (RAM-boot) kernel for safe U-Boot/serial testing
# without committing to flash.
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# ---- Build acceleration ----
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ---- Flow offloading (software + MediaTek PPE hardware) ----
# Required for firewall4's flow_offloading / flow_offloading_hw options to
# engage the MediaTek PPE offload path for the RTL8366UB switch.
CONFIG_PACKAGE_kmod-nft-offload=y

# ---- Web UI (optional, handy for validation) ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y

# ---- Switch / DSA / offload validation tools ----
CONFIG_PACKAGE_ethtool=y        # link speed / port state
CONFIG_PACKAGE_ip-full=y        # `ip -d link` DSA/bridge inspection
CONFIG_PACKAGE_tcpdump=y        # verify tagged frames on the trunk
CONFIG_PACKAGE_iperf3=y         # throughput / PPE offload verification

# Base OpenWrt already provides dnsmasq, firewall4, dropbear (SSH), netifd,
# DSA core, the in-tree rtl8366ub DSA driver + 802.1Q tagger, and mtk-eth
# drivers via the target defaults.
